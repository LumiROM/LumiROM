# Arreglos locales para One UI 9 en el A32.
#
# 1) JPEG: el kernel de LumiROM expone /dev/dma_heap/mtk_mm (DMA-BUF heaps +
#    heap ION mm de MTK), asi que el camino optimizado del vendor (libhwui /
#    libkumihodecoderservice) ya puede reservar memoria y no hace falta
#    desactivarlo con debug.jpegfull.opt.switch.
#
# 2) BBR: networksetting.rc del vendor pone bic; el odm se procesa despues.
on boot
    write /proc/sys/net/ipv4/tcp_congestion_control bbr

on property:sys.boot_completed=1
    write /proc/sys/net/ipv4/tcp_congestion_control bbr
